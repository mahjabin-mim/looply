# Copy to .env.local and fill in. Restart the server after changing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the site (needed behind proxies); optional locally
# APP_URL=https://your-site.vercel.app
# Random string used to sign login cookies in production
# AUTH_SECRET=
# Optional: password-reset emails via Resend
# RESEND_API_KEY=
